end

subgraph s5["<b>5. O C4AI: DAS ENTREVISTAS ÀS PUBLICAÇÕES</b>"]
    direction TB
    S5_INTRO["<b>O que o cotidiano<br>mantinha implícito</b><br><br>Quatro cenas que as falas<br>de Fábio e Cláudio<br>trouxeram à fala"]
    subgraph tacitas["Quatro cenas"]
        direction LR
        E1["Os post-its e<br>o veto: USP lidera,<br>Brasil diferencia,<br>IBM tem interesse"]
        E2["Os três potes:<br>FAPESP, FUSP e USP<br>como fontes<br>complementares"]
        E3["Propriedade<br>intelectual: a<br>irrelevância do<br>juridicamente central"]
        E4["Línguas indígenas<br>e as ambiguidades<br>do 'AI for Good'"]
    end
    NUMEROS["<b>Produção científica<br>e concentração</b><br><br>407 publicações (2020-2024),<br>curadoria manual desduplicada;<br>NLP2 lidera com 144 (35,4%),<br>KEML (56; 13,8%) e AgriBio (55; 13,5%);<br>os três maiores grupos somam 62,7%;<br>pico de 199 em 2023, queda para 55<br>em 2024 (base possivelmente defasada)"]
    S5_INTRO --> tacitas
    tacitas ==> NUMEROS
end

subgraph s6["<b>6. (CO)RELAÇÕES PARCIAIS: o fim da 'parceria' C4AI-IBM-FAPESP</b>"]
