end

subgraph s3["<b>3. CRIAR DEMANDA: a racionalidade de um ecossistema</b>"]
    direction TB
    S3_INTRO["<b>Criar demanda,<br>disseminar ecossistema</b><br><br>a fala de Cláudio na<br>bluetalks reunida à<br>lógica da IBM Research:<br>lucro de ponta, spin-off<br>por margem, computação<br>quântica, Red Hat"]
    subgraph dims["Quatro frentes de investigação"]
        direction LR
        D1["Histórica:<br>de Hollerith ao<br>open source via<br>serviços"]
        D2["Técnica:<br>codificação, controle<br>de infraestrutura,<br>abertura versus<br>fechamento"]
        D3["Organizacional:<br>aluguel, produtos<br>versus serviços,<br>capital intelectual"]
        D4["Institucional:<br>arranjos público-<br>privados, C4AI como<br>incubadora"]
    end
    S3_INTRO --> dims
end

subgraph s4["<b>4. A IBM</b>"]
    direction TB
    S4_INTRO["<b>De Hollerith (1890)<br>ao C4AI (2025)</b><br><br>quatro momentos que se<br>sedimentam:<br>da tabulação eletromecânica<br>do censo à infraestrutura de IA"]
