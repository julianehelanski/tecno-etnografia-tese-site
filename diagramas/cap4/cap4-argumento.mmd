style vb fill:transparent,stroke:#b8bec7,stroke-width:1px
style vc fill:transparent,stroke:#b8bec7,stroke-width:1px
style vd fill:transparent,stroke:#b8bec7,stroke-width:1px
style funcoes fill:transparent,stroke:#b8bec7,stroke-width:1px
style limite fill:transparent,stroke:#b8bec7,stroke-width:1px