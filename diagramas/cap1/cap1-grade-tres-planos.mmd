flowchart TB
 subgraph SUB["PLANO DA SUBSTÂNCIA — do que a entidade é feita"]
    direction TB
        H["Híbrido<br>mistura natureza + cultura,<br>ainda guarda os polos que mistura"]
  end
 subgraph PROP["PLANO DA PROPRIEDADE — o que se atribui à entidade"]
    direction TB
        P["Pensar, escrever, criar<br>atributos reivindicados como humanos,<br>que a tese recusa tomar como dados"]
        MC["Multiplicidade de claude<br>as competências não são posses,<br>e sim efeito da prática que o enacta"]
  end
 subgraph REL["PLANO DO EFEITO / RELAÇÃO — o que se faz aparecer no encontro"]
    direction TB
        QO["Quase-objeto / quase-máquina<br>só é o que é enquanto circula:<br>faz a passagem da substância à relação"]
        EP["Existência parcial<br>nunca completa,<br>depende das associações que a constituem"]
        CP["Conexão parcial<br>nomeia o plano relacional como tal"]
        MEC["Agência distribuída + fazer-com<br>mecanismo interno do plano:<br>como, na relação, as entidades agem juntas"]
  end
    EIXO((("A RELAÇÃO<br>constitui")))
    H ==>|o quase-objeto desloca<br>da substância para a relação| QO
    P -.->|a tese recusa<br>a pergunta do atributo| REL
    MC -.->|até a propriedade<br>é relacional| REL
    QO --> EP
    EP --> CP
    CP --> MEC
    REL ==>|tudo se faz na relação| EIXO
    SUB -. o argumento se desloca .-> REL
     H:::subbox
     P:::propbox
     MC:::propbox
     QO:::relbox
     EP:::relbox
     CP:::relbox
     MEC:::relbox
     EIXO:::eixobox
